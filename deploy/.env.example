# ─────────────────────────────────────────────────────────────────────────────
# Drikon production env — copy to ".env" and fill in. NEVER commit the real .env.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Domain ──────────────────────────────────────────────────────────────────
# Your bought domain, no scheme, no www. The storefront serves on this (+ www);
# the API serves on api.<that domain>.
SITE_DOMAIN=example.com
# Email used by Let's Encrypt for cert notices.
ACME_EMAIL=you@example.com

# ── PostgreSQL (runs in a container, data persisted in a volume) ────────────
POSTGRES_USER=drikon
POSTGRES_DB=drikon
# Use a long random value. e.g.  openssl rand -base64 24
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

# ── Auth secrets — MUST be ≥32 chars each. Generate fresh ones: ─────────────
#   openssl rand -base64 48
JWT_ACCESS_SECRET=CHANGE_ME_at_least_32_characters_long_secret
JWT_REFRESH_SECRET=CHANGE_ME_another_32_characters_long_secret

# ── Email (optional — for password reset / order mail via Resend) ───────────
EMAIL_FROM=Drikon <noreply@example.com>
RESEND_API_KEY=

# ── Cloudinary (recommended — admin image/logo/banner uploads) ──────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Google OAuth (optional — "Continue with Google") ────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
