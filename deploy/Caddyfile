# Automatic HTTPS via Let's Encrypt. Caddy obtains + renews certs on its own.
{
	email {$ACME_EMAIL}
}

# Redirect www → apex (canonical)
www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}

# Storefront (Next.js)
{$SITE_DOMAIN} {
	encode zstd gzip
	reverse_proxy web:3000
}

# API (NestJS)
{$API_DOMAIN} {
	encode zstd gzip
	reverse_proxy api:4000
}
