# ─────────────────────────────────────────────────────────────────────────────
# Drikon — Environment Variables
# Copy this file to .env and fill in real values. NEVER commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# ───── Node ─────
NODE_ENV=development

# ───── Database ─────
# Local docker-compose default. In production this is Render's managed
# Postgres — see DEPLOY.md, render.yaml sets it automatically.
DATABASE_URL="postgresql://drikon:drikon_dev_password@localhost:5432/drikon?schema=public"

# ───── API (NestJS) ─────
API_PORT=4000
API_HOST=0.0.0.0
# Comma-separated list of allowed origins for CORS
WEB_ORIGIN="http://localhost:3000"

# ───── JWT secrets ─────
# Generate with: openssl rand -base64 64
JWT_ACCESS_SECRET="CHANGE_ME_dev_access_secret_at_least_64_chars_long_xxxxxxxxxxxxxx"
JWT_REFRESH_SECRET="CHANGE_ME_dev_refresh_secret_at_least_64_chars_long_yyyyyyyyyyyy"
JWT_ACCESS_TTL=900            # 15 minutes (in seconds)
JWT_REFRESH_TTL=604800        # 7 days

# Cookie settings
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false            # set true in production (HTTPS only)

# ───── Google OAuth ─────
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:4000/auth/google/callback"

# ───── Email (Resend) ─────
# https://resend.com/api-keys
RESEND_API_KEY=""
EMAIL_FROM="Drikon <noreply@drikon.com>"

# ───── Cloudinary ─────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ───── Security ─────
ARGON2_MEMORY_COST=65536       # 64 MB
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4
RATE_LIMIT_LOGIN_MAX=5          # 5 attempts
RATE_LIMIT_LOGIN_WINDOW=60      # per 60 seconds
ACCOUNT_LOCK_THRESHOLD=5        # lock after 5 failed attempts in window
ACCOUNT_LOCK_DURATION=1800      # 30 min lockout

# ───── Observability ─────
LOG_LEVEL=info                 # trace | debug | info | warn | error | fatal

# ───── Frontend (Next.js public vars) ─────
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
